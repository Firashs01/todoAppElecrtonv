# =============================================================================
# FocusFlow / TodoApp
# =============================================================================
# Static HTML/CSS/JS app. Tasks and notes live in browser localStorage, so the
# only private project files are manual JSON exports, secrets, and local tooling.

# --- Private task/note exports ---------------------------------------------
# app.js exports files named tasks-YYYY-MM-DD.json
tasks-*.json
*.tasks.json
exports/
backups/
*.bak
*.backup

# --- Environment & secrets --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.local
config.local.*
settings.local.*

# --- Dependencies, build & test output -------------------------------------
node_modules/
dist/
build/
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.dsh-test/
.dsh/

# --- Logs & temp files ------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.pid

# --- Local databases / dumps ------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
dump/
dumps/

# --- OS & editor metadata ---------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp
*.swo
.vscode/
.idea/
*.code-workspace
.history/
