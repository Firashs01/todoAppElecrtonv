# =============================================================================
# FocusFlow (TodoAppElectron) — .gitignore
# =============================================================================
# Desktop task & notes manager built with Electron and native HTML/CSS/JS.

# --- Dependencies ------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Electron & Electron Forge build / packaging output -----------------------
# forge make and package output directory (contains platform binaries, zip, deb, etc.)
out/
dist/
build/
packages/
*.asar

# Electron Forge and bundler temporary cache
.webpack/
.vite/
.parcel-cache/

# Package installers & standalone binaries
*.deb
*.rpm
*.zip
*.tar.gz
*.tgz
*.AppImage
*.snap
*.dmg
*.pkg
*.exe
*.msi

# --- Private task/note exports & backups -------------------------------------
# app.js exports files named tasks-YYYY-MM-DD.json
tasks-*.json
*.tasks.json
exports/
backups/
*.bak
*.backup

# --- Environment & secrets --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.local
config.local.*
settings.local.*

# --- Test results & coverage ------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.dsh-test/
.dsh/

# --- Logs, debug traces & temp files ----------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# --- Local databases & dumps -------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
dump/
dumps/

# --- OS metadata -------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~
.directory
.fuse_hidden*
.Trash-*

# --- Editor & IDE settings ---------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/
*.swp
*.swo
